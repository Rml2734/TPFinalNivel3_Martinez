<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MiMaster.Master.cs" Inherits="TPFinalNivel3.Site1" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Mi Catálogo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

</head>
<body>
    <form id="form1" runat="server">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="Default.aspx">Catálogo Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link active" href="Default.aspx">Home</a>
                        </li>

                        <li class="nav-item" id="liFavoritos" runat="server">
                            <a class="nav-link" href="Favoritos.aspx">Mis Favoritos</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="ListaArticulos.aspx">Lista Artículos</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center me-3 shadow-sm">
                        <% if (!negocio.Seguridad.sesionActiva(Session["usuario"]))
                            { %>
                        <!-- ... (tus botones de Login y Registro se quedan igual) ... -->
                        <a href="Login.aspx" class="btn btn-outline-success me-2">Login</a>
                        <a href="Registro.aspx" class="btn btn-primary">Registrarse</a>
                        <% }
                        else
                        { %>
                        <!-- Sección de Perfil y Salir -->
                        <a href="MiPerfil.aspx" class="d-flex align-items-center text-decoration-none text-light me-3">
                            <!-- Texto del correo (Label) -->
                            <asp:Label ID="lblUser" runat="server" CssClass="me-2" />
                            <!-- Foto de Perfil Redonda -->
                            <asp:Image ID="imgAvatar" runat="server"
                                CssClass="rounded-circle border border-light shadow-sm"
                                style="height:40px; width:40px; object-fit: cover; background-color: #ccc; display: block;"
                                ImageUrl="https://www.pngkit.com/png/full/301-3012694_account-user-profile-avatar-comments-fa-user-circle.png" />
                        </a>
                        <asp:Button Text="Salir" ID="btnSalir" OnClick="btnSalir_Click" CssClass="btn btn-outline-danger btn-sm" runat="server" />
                        <% } %>
                    </div>

                </div>
            </div>
        </nav>

        <div class="container mt-4">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <footer class="text-center mt-5 py-3 border-top">
            <p>&copy; 2026 - Catálogo de Roberto - Proyecto Nivel 3</p>
        </footer>
    </form>
</body>

</html>
