<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MiMaster.Master.cs" Inherits="TPFinalNivel3.Site1" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mi Catálogo</title>

    <link rel="shortcut icon" type="image/png" id="favicon" runat="server" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <%-- ESTILOS PERSONALIZADOS  --%>
    <style>
        body {
            background-color: #f8f9fa;
        }
        /* Animaciones y transformaciones de componentes visuales (UX) */
        .card-custom:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.15) !important;
        }

        .rounded-pill {
            border-radius: 50px !important;
        }

        .transition-all {
            transition: all 0.3s ease;
        }

        /* Reglas CSS específicas para la paleta de modo oscuro */
        [data-bs-theme="dark"] body {
            background-color: #121212 !important;
            color: #f8f9fa !important;
        }

        [data-bs-theme="dark"] .card {
            background-color: #1e1e1e !important;
            border: 1px solid #333 !important;
        }

        [data-bs-theme="dark"] .bg-light,
        [data-bs-theme="dark"] .card-img-top,
        [data-bs-theme="dark"] .position-relative {
            background-color: #2a2a2a !important;
        }

        [data-bs-theme="dark"] .card-body h5,
        [data-bs-theme="dark"] .card-title {
            color: #0d6efd !important;
        }

        [data-bs-theme="dark"] .text-muted,
        [data-bs-theme="dark"] .card-text.small,
        [data-bs-theme="dark"] small {
            color: #bbb !important;
        }

        [data-bs-theme="dark"] .card-footer {
            background-color: #1e1e1e !important;
        }
        
        /* Modificadores adaptativos para la interfaz de Contingencia de Excepciones */
        .card-error {
            background-color: #ffffff;
            border: 1px solid rgba(0,0,0,0.1);
        }
        
        [data-bs-theme="dark"] .card-error {
            background-color: #1e1e1e !important;
            border: 1px solid #333 !important;
            color: #f8f9fa;
        }

        [data-bs-theme="dark"] .lead {
            color: #bbb;
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

</head>
<body>
    <form id="form1" runat="server">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="Default.aspx">Catálogo Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link active" href="Default.aspx">Home</a>
                        </li>

                        <li class="nav-item" id="liFavoritos" runat="server">
                            <a class="nav-link" href="Favoritos.aspx">Mis Favoritos</a>
                        </li>

                        <li class="nav-item" id="liListaArticulos" runat="server">
                            <a class="nav-link" href="ListaArticulos.aspx">Lista Artículos</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center me-3 ">

                        <button class="btn btn-outline-light btn-sm me-2 me-3 transition-all" id="btn-theme" type="button">
                            🌙 / ☀️
                        </button>

                        <% if (!negocio.Seguridad.sesionActiva(Session["usuario"]))
                            { %>
                        <!-- ... ( botones de Login y Registro) ... -->
                        <a href="Login.aspx" class="btn btn-outline-success btn-sm me-2 px-3 rounded-pill">Login</a>
                        <a href="Registro.aspx" class="btn btn-primary btn-sm px-3 rounded-pill">Registrarse</a>
                        <% }
                            else
                            { %>
                        <!-- Sección de Perfil y Salir -->
                        <a href="MiPerfil.aspx" class="d-flex align-items-center text-decoration-none text-light me-3">
                            
                            <asp:Label ID="lblUser" runat="server" CssClass="me-2" />
                            <!-- Foto de Perfil Redonda -->
                            <asp:Image ID="imgAvatar" runat="server"
                                CssClass="rounded-circle border border-light shadow-sm"
                                Style="height: 40px; width: 40px; object-fit: cover; display: block;" />
                        </a>
                        <asp:Button Text="Salir" ID="btnSalir" OnClick="btnSalir_Click" CssClass="btn btn-outline-danger btn-sm rounded-pill px-3" runat="server" />
                        <% } %>
                    </div>

                </div>
            </div>
        </nav>

        <div class="container mt-4">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <footer class="text-center mt-5 py-3 border-top bg-light text-muted">
            <p>&copy; 2026 - Catálogo de Roberto - Proyecto Nivel 3</p>
        </footer>
    </form>
</body>
<script>
    const btnTheme = document.getElementById('btn-theme');
    const htmlElement = document.documentElement;

    btnTheme.addEventListener('click', () => {
        const currentTheme = htmlElement.getAttribute('data-bs-theme');
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';

        htmlElement.setAttribute('data-bs-theme', newTheme);

        // Opcional: Guardar la preferencia para que no se pierda al recargar
        localStorage.setItem('theme', newTheme);
    });

    // Restauración preventiva del estado visual preferido por el usuario
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme) {
        htmlElement.setAttribute('data-bs-theme', savedTheme);
    }
</script>

</html>
